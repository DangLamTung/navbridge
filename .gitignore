# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# GraphHopper build artifacts (large; rebuild via tools/build_graph.sh)
tools/data/*.osm.pbf
tools/data/*.ghz
tools/data/*_graph/
tools/data/extract_test/

# Planetiler map-build inputs/outputs (large binaries; not app code).
# Backed up locally under ~/Documents/Eink/map-tools-backup/.
tools/planetiler.jar
tools/data/sources/
tools/saigon_z16.pmtiles
tools/data/saigon.pmtiles

# Recorded test media + trip replay data (large; dev-only artifacts)
*.mp4
recorded_replay.json
2026-08-08_200603_*.json
assets/trips/

# Local secrets — never commit. Vietmap keys live in .env and are loaded by
# tool/env.sh -> --dart-define at build time.
.env

# Offline POI build intermediates (regenerate with tools/poi/build_pois.py).
tools/poi/*.osm.pbf
tools/poi/*.geojson

# Android build outputs
android/build/

# Local screenshots may contain personal info — never commit.
docs/screenshots/
