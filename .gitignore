# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# GraphHopper build artifacts (large; rebuild via tools/build_graph.sh)
tools/data/*.osm.pbf
tools/data/*.ghz
tools/data/*_graph/
tools/data/extract_test/

# Planetiler map-build inputs/outputs (large binaries; not app code).
# Backed up locally under ~/Documents/Eink/map-tools-backup/.
tools/planetiler.jar
tools/data/sources/
tools/saigon_z16.pmtiles
tools/data/saigon.pmtiles

# Recorded test media + trip replay data (large; dev-only artifacts)
*.mp4
recorded_replay.json
2026-08-08_200603_*.json
assets/trips/

# Local secrets — never commit. Vietmap keys live in .env and are loaded by
# tool/env.sh -> --dart-define at build time.
.env

# Local release signing — never commit.
android/key.properties
android/app/*.jks
android/app/*.keystore
*.jks
*.keystore

# Offline POI build intermediates (regenerate with tools/poi/build_pois.py).
tools/poi/*.osm.pbf
tools/poi/*.geojson

# Vietmap E-DOG source extracts for the sign build (large; re-download first).
tools/data/vietmap_kc01/

# Update-server release payload + pulled device trips (local data, not source).
update/
docs/trips/

# Continuous trip-log spools (written on device; a `.part` means a drive that
# was killed mid-way and will be rebuilt by recoverSpooledTrips at next launch).
*.part

# Local scratch / backups (never commit).
*.orig
.tmp_*.png
assets/offline_map/_bak_*/

# Android build outputs
android/build/

# Local screenshots may contain personal info — never commit.
docs/screenshots/

# Backup copies of the enforcement databases — sensitive / redistribution-
# restricted (police camera locations, road-sign DB, posted speed limits from
# DATMAP / Waze / Vietmap). Only the VALID-EMPTY placeholders are committed;
# the real data is generated locally by tool/ scripts and placed over them on
# the build machine (git tracks the placeholders; see assets/offline_map/).
assets/offline_map/*.bak
assets/offline_map/*.bak_*

# Dev-only: regenerable Google TTS voice audition clips (tools/build_voice_pack_gcp.py sample)
assets/audio/voice_audition/

# Sign-pack backups written by tools/signs/*.py before a rewrite (10 MB each).
assets/offline_map/*.bak-*

# Dev-only download sources (747 MB of Natural-Earth / water shapefiles) and
# pre-built tile archives (433 MB). Regenerable; never part of the app.
data/sources/
tools/data/*.pmtiles

# POLICY-SENSITIVE: provincial-police "phạt nguội" enforcement data and the
# crawl that produces it. Kept locally only - never in the repo, never on a CI
# runner. See private/ for the quarantined archive.
private/
tool/data/police_*
tool/fetch_police_cameras.py
tool/offline_geocode.py
tool/photon_geocode.py

# Voice packs: large regenerable binaries, fetched from the voice-packs release
# asset at build time (tool/fetch_assets.sh). The paths stay declared in
# pubspec.yaml - they must still be bundled into the APK.
assets/audio/voice_vn_*/

# Local scratch: 1.4 GB of downloaded shapefile sources, tile weights and
# one-off analysis scripts. Never part of the app or the pipeline.
data/

# Generated analysis reports. docs/ keeps the MARKDOWN that explains the work,
# not the HTML/PNG dumps it produced.
docs/*.png
docs/eval.html
docs/gps_deviation_*.html
docs/hn_sg_*.html
docs/lamdong_km_cameras.html
docs/limit_audit_*.html
docs/resident_groundtruth.html
docs/sim_data_*.json
docs/simnav_*.txt
docs/simulation_lbb.html
docs/voice_*.html
docs/apbac_truongchinh_before_after.html

# Recorded drives dropped into the repo root (personal GPS dumps, tens of MB)
/*_Gộp_ngày.json
/*_Chuyến_đi.json
